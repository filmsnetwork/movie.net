{
  "id": "./",
  "name": "movies.net",
  "short_name": "movies.net",
  "description": "Watch movies and series, keep a watch list and pick up where you left off.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0d0f13",
  "theme_color": "#0d0f13",
  "categories": ["entertainment", "movies", "video"],
  "prefer_related_applications": false,
  "launch_handler": {"client_mode": "navigate-existing"},
  "handle_links": "preferred",
  "edge_side_panel": {"preferred_width": 420},
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"},
    {"src": "icon.svg", "sizes": "any", "type": "image/svg+xml"}
  ],
  "screenshots": [
    {"src": "screenshots/wide-home.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Home"},
    {"src": "screenshots/wide-library.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Library"},
    {"src": "screenshots/narrow-home.png", "sizes": "540x960", "type": "image/png", "form_factor": "narrow", "label": "Home"},
    {"src": "screenshots/narrow-library.png", "sizes": "540x960", "type": "image/png", "form_factor": "narrow", "label": "Library"}
  ],
  "shortcuts": [
    {"name": "Search", "short_name": "Search", "url": "./?v=search", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]},
    {"name": "Library", "short_name": "Library", "url": "./?v=library", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]},
    {"name": "My List", "short_name": "My List", "url": "./?v=list", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]}
  ],
  "share_target": {"action": "./", "method": "GET", "params": {"title": "title", "text": "text", "url": "url"}},
  "protocol_handlers": [{"protocol": "web+movies", "url": "./?q=%s"}]
}
